# =============================================================================
# TalentGate — environment variables (Vite build)
# Copy to .env.local and fill in. NEVER commit real values.
# =============================================================================

# Supabase project URL — Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase ANON (publishable) key — safe for browsers; access is enforced by RLS.
# Supabase Dashboard -> Project Settings -> API -> anon/public key
VITE_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# IMPORTANT — what is intentionally NOT here:
#   * The Supabase SERVICE ROLE key must never be added to this frontend.
#     If a trusted server process is ever needed (e.g. batch jobs), keep that
#     key in the server's own environment — never prefixed with VITE_/NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
