# Environment Variables for Edge Functions
# Copy this to .env and fill in your values
# Then run: supabase secrets set --env-file .env

# Supabase Project URL
SUPABASE_URL=https://khaxdoosuzzanardcnjx.supabase.co

# Supabase Anon Key (public, safe for frontend)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SECRET - never expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Custom domain for Edge Functions
# EDGE_FUNCTIONS_DOMAIN=https://your-project.supabase.co/functions/v1
